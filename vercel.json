{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/timetable_sync",          "schedule": "0 6 * * *" },
    { "path": "/api/news_aggregator",         "schedule": "0 5 * * *" },
    { "path": "/api/news_aggregator",         "schedule": "0 14 * * *" },
    { "path": "/api/email_scanner",           "schedule": "0 4 * * *" },
    { "path": "/api/daily_question",          "schedule": "0 1 * * *" },
    { "path": "/api/competitions_aggregator", "schedule": "0 3 * * 1" }
  ]
}
